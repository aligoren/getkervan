{
  "name": "@kervan/spec-runtime",
  "version": "0.1.0-rc.2",
  "description": "Turn a kervan.yaml spec into MCP tools that call HTTP APIs: templates, JMESPath output selection, SSRF protection and secret redaction.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "yaml",
    "no-code",
    "http",
    "ai-agents"
  ],
  "license": "MIT",
  "author": {
    "name": "Kervan contributors",
    "url": "https://getkervan.dev"
  },
  "homepage": "https://getkervan.dev",
  "bugs": {
    "url": "https://github.com/orchesta/getkervan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchesta/getkervan.git",
    "directory": "packages/spec-runtime"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/kervan.schema.json": "./schema/kervan.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!**/*.tsbuildinfo",
    "schema"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "gen:schema": "node scripts/gen-schema.mjs",
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@jmespath-community/jmespath": "^1.3.0",
    "@kervan/core": "workspace:^",
    "ipaddr.js": "^2.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kervan/transport": "workspace:^",
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
