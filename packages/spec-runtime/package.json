{
  "name": "@kervan/spec-runtime",
  "version": "0.1.0",
  "description": "Turn a declarative kervan.yaml spec into MCP tools that call HTTP APIs safely.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/kervan.schema.json": "./schema/kervan.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "schema",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spec",
    "yaml",
    "http",
    "no-code"
  ],
  "scripts": {
    "gen:schema": "node scripts/gen-schema.mjs",
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@jmespath-community/jmespath": "^1.3.0",
    "@kervan/core": "workspace:^",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kervan/transport": "workspace:^",
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
