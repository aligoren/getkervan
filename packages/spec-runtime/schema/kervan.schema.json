{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string"
    },
    "secrets": {
      "description": "Secrets this spec may use as {{secrets.NAME}}: a name, or { name, hosts } to allow sending it only to those hosts. Only declared names are resolved.",
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
              },
              "hosts": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^(?:[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.?|\\[[0-9A-Fa-f:.]+\\])$"
                },
                "description": "The only hosts this secret may be sent to, matched exactly (no subdomains or wildcards), e.g. api.example.com."
              }
            },
            "required": ["name", "hosts"],
            "additionalProperties": false,
            "description": "A secret bound to the hosts it may be sent to."
          }
        ]
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 120000,
              "description": "Request timeout in milliseconds (connect and response)."
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52428800,
              "description": "Largest response body accepted, after decompression."
            },
            "maxOutputChars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Longest tool output sent to the model; longer output is cut."
            },
            "allowInsecureHttp": {
              "description": "Allow plain http:// URLs. Off by default: secrets would travel unencrypted.",
              "type": "boolean"
            },
            "followRedirects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "description": "How many redirects to follow (default 0). Each hop is checked again; secret headers are dropped when the host changes."
            }
          },
          "additionalProperties": false,
          "description": "Defaults for every tool's HTTP request."
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "perMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "additionalProperties": false,
          "description": "Per-tool limits on outgoing calls (defaults: 60 per minute, 10 at once)."
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "description": "Tool name: 1-128 of A-Z a-z 0-9 _ - ."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the tool does; the model's main guidance."
          },
          "input": {
            "description": "JSON Schema of the arguments; must have `type: object`.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "annotations": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "readOnlyHint": {
                "type": "boolean"
              },
              "destructiveHint": {
                "type": "boolean"
              },
              "idempotentHint": {
                "type": "boolean"
              },
              "openWorldHint": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "rateLimit": {
            "type": "object",
            "properties": {
              "perMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "additionalProperties": false,
            "description": "Per-tool limits on outgoing calls (defaults: 60 per minute, 10 at once)."
          },
          "http": {
            "type": "object",
            "properties": {
              "method": {
                "default": "GET",
                "type": "string",
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "Request URL. Scheme, host and port must be literal; {{input.x}} and {{secrets.X}} may appear in the path. Put templated query parameters under `query`."
              },
              "query": {
                "description": "Query parameters. Values may contain templates.",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": ["string", "number", "boolean"]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": ["string", "number", "boolean"]
                      }
                    }
                  ]
                }
              },
              "headers": {
                "description": "Request headers. Names are literal; values may contain templates.",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": ["string", "number", "boolean"]
                }
              },
              "body": {
                "description": "JSON request body. String values may contain templates."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 120000,
                "description": "Request timeout in milliseconds (connect and response)."
              },
              "maxResponseBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52428800,
                "description": "Largest response body accepted, after decompression."
              },
              "allowInsecureHttp": {
                "type": "boolean"
              },
              "followRedirects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5,
                "description": "How many redirects to follow (default 0). Each hop is checked again; secret headers are dropped when the host changes."
              }
            },
            "required": ["url"],
            "additionalProperties": false,
            "description": "The HTTP request this tool makes."
          },
          "output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "select": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "JMESPath expression that picks and reshapes the fields the model sees, e.g. `{temp: main.temp}`. External API output is untrusted; select only what is needed."
                  },
                  "schema": {
                    "description": "JSON Schema of the selected value. When set, the tool returns structured content.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "maxOutputChars": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "description": "Longest tool output sent to the model; longer output is cut."
                  }
                },
                "required": ["select"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "raw": {
                    "type": "boolean",
                    "const": true,
                    "description": "Return the response body as text (cut to maxOutputChars) instead of selecting fields. Prefer `select`."
                  },
                  "maxOutputChars": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "description": "Longest tool output sent to the model; longer output is cut."
                  }
                },
                "required": ["raw"],
                "additionalProperties": false
              }
            ],
            "description": "How the response becomes the tool result: `select` (JMESPath) or `raw: true`."
          }
        },
        "required": ["name", "description", "http", "output"],
        "additionalProperties": false
      }
    }
  },
  "required": ["specVersion", "name", "version", "tools"],
  "additionalProperties": false,
  "title": "Kervan spec",
  "description": "A kervan.yaml file: MCP tools backed by HTTP requests."
}
