{
  "name": "@kervan/core",
  "version": "0.1.0-rc.1",
  "description": "A thin, typed layer over the official MCP TypeScript SDK: define MCP tools with Zod schemas, validated arguments, timeouts and masked errors.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "typescript",
    "zod",
    "ai-agents",
    "tools"
  ],
  "license": "MIT",
  "author": {
    "name": "Kervan contributors",
    "url": "https://getkervan.dev"
  },
  "homepage": "https://getkervan.dev",
  "bugs": {
    "url": "https://github.com/orchesta/getkervan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchesta/getkervan.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
