{
  "name": "@kervan/transport",
  "version": "0.1.0",
  "description": "stdio and Streamable HTTP transports for Kervan MCP apps (Node and fetch runtimes).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "stdio",
    "hono",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aligoren/kervan.git",
    "directory": "packages/transport"
  },
  "scripts": {
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kervan/core": "workspace:^",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  }
}
