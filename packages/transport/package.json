{
  "name": "@kervan/transport",
  "version": "0.1.0-rc.2",
  "description": "stdio and stateless Streamable HTTP transports for Kervan MCP servers: a Node.js server, a standard fetch handler and an in-memory test client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "typescript",
    "streamable-http",
    "stdio",
    "ai-agents"
  ],
  "license": "MIT",
  "author": {
    "name": "Kervan contributors",
    "url": "https://getkervan.dev"
  },
  "homepage": "https://getkervan.dev",
  "bugs": {
    "url": "https://github.com/orchesta/getkervan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchesta/getkervan.git",
    "directory": "packages/transport"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kervan/core": "workspace:^",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  }
}
