{
  "name": "kervan",
  "version": "0.1.0-rc.2",
  "description": "The kervan command line: create MCP server projects, develop with hot reload and an inspector, serve kervan.yaml specs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cli",
    "yaml",
    "typescript",
    "ai-agents"
  ],
  "license": "MIT",
  "author": {
    "name": "Kervan contributors",
    "url": "https://getkervan.dev"
  },
  "homepage": "https://getkervan.dev",
  "bugs": {
    "url": "https://github.com/orchesta/getkervan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchesta/getkervan.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.3 || >=24.21.0"
  },
  "bin": {
    "kervan": "./bin/kervan.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "templates",
    "!dist/**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@kervan/core": "workspace:^",
    "@kervan/spec-runtime": "workspace:^",
    "@kervan/transport": "workspace:^",
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
