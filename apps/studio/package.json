{
  "name": "@kervan/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Kervan Studio: a self-hosted web app for writing, publishing and serving kervan.yaml MCP servers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kervan-studio": "./bin/kervan-studio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kervan/core": "workspace:^",
    "@kervan/spec-runtime": "workspace:^",
    "@kervan/transport": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11"
  }
}
