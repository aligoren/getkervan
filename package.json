{
  "name": "kervan-monorepo",
  "private": true,
  "homepage": "https://getkervan.dev",
  "bugs": {
    "url": "https://github.com/aligoren/getkervan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aligoren/getkervan.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.23.3 || >=24.21.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @kervan/studio build:web",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/studio/web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "check:pack": "pnpm -r --filter \"./packages/*\" run check:pack",
    "test:pack": "pnpm build && node scripts/pack-check.mjs",
    "e2e": "pnpm build && pnpm --filter @kervan/studio e2e",
    "site:schema": "node scripts/site-schema.mjs",
    "site:build": "node scripts/site/build.mjs",
    "site:generate": "node scripts/site/generate.mjs",
    "site:screenshots": "node scripts/site/screenshots.mjs",
    "site:serve": "node scripts/site/serve.mjs",
    "site:verify": "node scripts/site/verify.mjs",
    "check:site": "node scripts/check-site.mjs",
    "try:new": "node scripts/try-new.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "axe-core": "4.13.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
