{
  "name": "kervan-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "check:pack": "pnpm -r --filter \"./packages/*\" run check:pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
