{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/node_modules", "!**/*.tsbuildinfo", "!**/dist-web"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/studio/src/**", "apps/studio/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kervan/**",
                      "!@kervan/core",
                      "!@kervan/transport",
                      "!@kervan/transport/node",
                      "!@kervan/spec-runtime",
                      "!@kervan/spec-runtime/schema/kervan.schema.json"
                    ],
                    "message": "Studio uses only the public entry points of @kervan/* packages (see docs/API.md)."
                  },
                  {
                    "group": ["**/packages/**"],
                    "message": "Studio must not import framework sources directly; use the package's public API."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
